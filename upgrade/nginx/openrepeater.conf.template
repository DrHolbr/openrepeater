# Bench HTTP site for the OpenRepeater UI.
# PHP 8 FPM socket is substituted at install time. No PHP 5 socket, no TLS redirect.
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name orp-test;

	root /var/www/openrepeater;
	index index.php index.html;

	client_max_body_size 25M;

	location ^~ /install/ {
		deny all;
	}

	location ^~ /upgrade/ {
		deny all;
	}

	# Archives here contain backup.sql, including password hashes.
	# nginx does not serve this tree. The session endpoint streams a file.
	location ~* ^/backup/ {
		deny all;
	}

	location /internal-backup/ {
		internal;
		alias /var/www/openrepeater/backup/;
	}

	# Module uploads and the sounds anchor. Audio under /sounds/ is served.
	# Dotfiles, databases, and archives are denied here because this regex
	# is matched before the server-wide dotfile and database locations.
	location ~* ^/(modules|sounds)/ {
		location ~ /\. {
			deny all;
		}
		location ~* \.(php|php[0-9]|pht|phtml|phps|phar|inc|cgi|pl|py|rb|sh|db|sqlite|sqlite3|sql|tar|gz|tgz|zip|bak)$ {
			deny all;
		}
	}

	location ~* \.(db|sqlite|sqlite3)$ {
		deny all;
	}

	location ~ /\. {
		deny all;
	}

	location / {
		try_files $uri $uri/ /index.php?$query_string;
	}

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:__PHP_FPM_SOCK__;
	}
}
