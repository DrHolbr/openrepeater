function audio_inputs {
	arecord -l
}

function audio_outputs {
	aplay -l
}

function audio_version {
	cat /proc/asound/version 2>&1
}


### AUDIO FUNCTIONS ###
function set_mixer {
	if native_functional_token || functional_test_on; then
		echo "refused: mixer control is not supported"
		return 1
	fi
	if bench_refuses "set_mixer"; then
		return 1
	fi
	if [ -n "$3" ]; then
		amixer -c$3 set "$1" $2
	else
		amixer set "$1" $2
	fi
}

function alsamixer_backup {
	local tmp
	# Untrusted functional-test stays refused. The trusted token keeps the
	# backup, and root never opens the www-data path.
	if functional_test_on && ! native_functional_token; then
		echo "refused: alsa backup stays blocked without a trusted functional-test token"
		return 1
	fi
	if bench_refuses "alsa backup"; then
		return 1
	fi
	if ! alsa_state_allowed "$1"; then
		return 1
	fi
	tmp=$(mktemp)
	if ! alsactl --file "$tmp" store; then
		rm -f "$tmp"
		echo "refused: alsactl store failed"
		return 1
	fi
	if ! alsa_state_allowed "$1"; then
		rm -f "$tmp"
		return 1
	fi
	if ! timeout 5 setpriv --reuid=www-data --regid=www-data --init-groups -- tee -- "$1" < "$tmp" >/dev/null; then
		rm -f "$tmp"
		echo "refused: alsa state was not written as www-data"
		return 1
	fi
	rm -f "$tmp"
}

function alsamixer_restore {
	local tmp
	if functional_test_on && ! native_functional_token; then
		echo "refused: alsa restore stays blocked without a trusted functional-test token"
		return 1
	fi
	if bench_refuses "alsa restore"; then
		return 1
	fi
	if ! alsa_state_allowed "$1"; then
		return 1
	fi
	tmp=$(mktemp)
	if ! wwwdata_read_capped "$1" "$tmp"; then
		rm -f "$tmp"
		echo "refused: alsa state was not read as www-data"
		return 1
	fi
	if ! alsactl --file "$tmp" restore; then
		rm -f "$tmp"
		echo "refused: alsactl restore failed"
		return 1
	fi
	rm -f "$tmp"
}


