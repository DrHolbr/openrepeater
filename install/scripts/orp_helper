#!/bin/bash
# Copyright ©2017 OpenRepeater Project - Aaron Crawford, N3MBH & Richard Neese KB3VGW
# Licended under GPL v2 or later

# This is a helper script for OpenRepeater. This script is primarily intended
# to extend the functionality of the of the ORP web user interface and allow it
# to execute specific system commands that it would not normally be able to
# perform due to security reasons in Linux. DO NOT INCLUDE commands in this
# script that a potential hacker could utilize to compromise the system if the
# web server were to be compromised. This script should be a delicate balance
# between needed functionality in the web interface and security. 

# NOTE: NO NEED TO PREFIX COMMANDS WITH SUDO AS THIS SCRIPT IS INTENDED TO BE RUN AS ROOT USING SUDO COMMAND

####### WORK IN PROGRESS........

###############################################################################
# DEFINE FUNCTIONS
###############################################################################

### SVXLINK FUNCTIONS ###
function display_help {
	echo "OPEN REPEATER HELPER"
	echo "This is a helper script for OpenRepeater. This script is primarily intended"
	echo "to extend the functionality of the of the ORP web user interface and allow it"
	echo "to execute specific system commands that it would not normally be able to"
	echo "perform due to security reasons in Linux."
	echo ""
	echo "USAGE: orp_helper [service] [option]"
}

function bench_test_harness {
	[ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ] || return 1
	local real
	real=$(tr -d '[:space:]' < /etc/hostname 2>/dev/null || true)
	[ "$real" = "orp-test" ] && return 1
	[ -f /etc/openrepeater/bench-mode ] && return 1
	return 0
}

function bench_marker_path {
	if bench_test_harness && [ -n "${ORP_BENCH_MARKER:-}" ]; then
		printf '%s' "$ORP_BENCH_MARKER"
	else
		printf '%s' /etc/openrepeater/bench-mode
	fi
}

function bench_hostname {
	local file=/etc/hostname
	if bench_test_harness && [ -n "${ORP_BENCH_HOSTNAME_FILE:-}" ]; then
		file=$ORP_BENCH_HOSTNAME_FILE
	fi
	if [ -f "$file" ]; then
		tr -d '[:space:]' < "$file"
	fi
}

function operating_mode_file {
	if bench_test_harness && [ -n "${ORP_OPERATING_MODE_FILE:-}" ]; then
		printf '%s' "$ORP_OPERATING_MODE_FILE"
	else
		printf '%s' /etc/openrepeater/operating-mode
	fi
}

function operating_mode_token {
	local file perm owner token
	file=$(operating_mode_file)
	[ -f "$file" ] || return 0
	[ -L "$file" ] && return 0
	perm=$(stat -c %a "$file")
	# Reject group or other write. stat %a is decimal, so use the permission bits.
	if find "$file" -perm /022 | grep -q .; then
		return 0
	fi
	if ! bench_test_harness; then
		owner=$(stat -c %u "$file")
		[ "$owner" = 0 ] || return 0
	fi
	token=$(tr -d '[:space:]' < "$file")
	case "$token" in
		bench|functional-test) printf '%s' "$token" ;;
	esac
}

function functional_test_on {
	[ "$(operating_mode_token)" = "functional-test" ]
}

function bench_mode_on {
	# functional-test is not bench. A missing or untrusted mode file does
	# not turn hostname orp-test into legacy operation.
	local token
	token=$(operating_mode_token)
	if [ "$token" = "functional-test" ]; then
		return 1
	fi
	if [ "$token" = "bench" ]; then
		return 0
	fi
	if [ "$(bench_hostname)" = "orp-test" ]; then
		return 0
	fi
	[ -f "$(bench_marker_path)" ]
}

function drive_refuses {
	if functional_test_on || bench_mode_on; then
		echo "refused: GPIO and PTT setup stay blocked ($1). This is not a service start and not proof a transmitter unkeyed."
		return 0
	fi
	return 1
}

function alsa_state_allowed {
	case "$1" in
		/var/www/openrepeater/backup/build/alsamixer.state|/var/www/openrepeater/backup/restore/alsamixer.state)
			if [ -L "$1" ]; then
				echo "refused: alsa state path is a symlink"
				return 1
			fi
			return 0
			;;
		*)
			echo "refused: alsa path is outside the backup directory"
			return 1
			;;
	esac
}

function bench_refuses {
	if bench_mode_on; then
		echo "refused: bench mode blocks $1"
		return 0
	fi
	return 1
}

function svxlink_disable {
	echo "SVXLink Disable"
	service svxlink stop
	systemctl disable svxlink.service
}

function svxlink_enable {
	if bench_refuses "svxlink enable"; then
		return 1
	fi
	echo "SVXLink Enable"
	systemctl enable svxlink.service
	service svxlink start
}

function svxlink_service_ctl {
	local action=$1
	local rc
	if [ "$action" = "start" ] || [ "$action" = "restart" ]; then
		if ! config_matches_snapshot; then
			echo "refused: svxlink.conf is not the disconnected-test snapshot. Start was not called."
			return 1
		fi
		if ! native_inputs >/dev/null || ! native_runtime >/dev/null; then
			echo "refused: native preflight failed. Start was not called."
			native_inputs || true
			native_runtime || true
			return 1
		fi
		if native_start_blocked; then
			return 1
		fi
	fi
	# Never unmask. A masked unit is service-disabled, which is separate
	# from an unresolved GPIO number and from the dummy audio path.
	if [ -n "${ORP_SYSTEMCTL:-}" ]; then
		"${ORP_SYSTEMCTL}" "$action" svxlink.service
		return $?
	fi
	systemctl "$action" svxlink.service
	rc=$?
	if systemctl is-enabled svxlink.service 2>/dev/null | grep -q '^masked$'; then
		echo "service-disabled: svxlink.service is masked. Unmask was not performed."
		return "$rc"
	fi
	systemctl is-active svxlink.service || true
	return "$rc"
}

function svxlink_restart {
	if functional_test_on; then
		svxlink_service_ctl restart
		return $?
	fi
	if bench_refuses "svxlink restart"; then
		return 1
	fi
	service svxlink restart
	svxlink_status
}

function svxlink_stop {
	if functional_test_on; then
		svxlink_service_ctl stop
		return $?
	fi
	if bench_refuses "svxlink stop"; then
		return 1
	fi
	service svxlink stop
	svxlink_status
}

function svxlink_start {
	if functional_test_on; then
		svxlink_service_ctl start
		return $?
	fi
	if bench_refuses "svxlink start"; then
		return 1
	fi
	service svxlink start
	svxlink_status
}

function svxlink_status {
	systemctl is-active svxlink
}

function svxlink_gpio_up {
	if drive_refuses "svxlink gpio_up"; then
		return 1
	fi
	"${SVXLINK_GPIO_UP_BIN:-/usr/sbin/svxlink_gpio_up}"
	echo up
}

function svxlink_gpio_down {
	if drive_refuses "svxlink gpio_down"; then
		return 1
	fi
	"${SVXLINK_GPIO_DOWN_BIN:-/usr/sbin/svxlink_gpio_down}"
	echo down
}


### SYSTEM FUNCTIONS ###
# The web process never supplies this file. Root renders one fixed
# disconnected-test document. A staged svxlink.conf is ignored, including
# ORP_STAGED_CONFIG, so a check-then-install race cannot change the bytes.
function config_real_file() {
	local path=$1
	[ -f "$path" ] && [ ! -L "$path" ]
}

# Source build on orp-test: prefix /usr/local, SYSCONF_INSTALL_DIR=/etc,
# libraries in /usr/local/lib (not the multiarch distro directories).
# ORP_ROOT is a fixture prefix. The text written into svxlink.conf stays
# the real absolute path the process opens.
function native_path() {
	printf '%s%s' "${ORP_ROOT:-}" "$1"
}

function native_harness() {
	[ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]
}

function native_open_mode() {
	find "$1" -maxdepth 0 -perm /022 | grep -q .
}

function native_root_owned() {
	if native_harness; then
		return 0
	fi
	[ "$(stat -c '%u:%g' "$1")" = "0:0" ]
}

function native_report_file() {
	local logical=$1 path
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ ! -f "$path" ]; then
		echo "missing: ${logical} is not a regular file"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_root_owned "$path"; then
		echo "missing: ${logical} is not root:root"
		return 1
	fi
	echo "ok: ${logical}"
	return 0
}

function native_report_dir() {
	local logical=$1 path
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ ! -d "$path" ]; then
		echo "missing: ${logical} is not a directory"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_root_owned "$path"; then
		echo "missing: ${logical} is not root:root"
		return 1
	fi
	echo "ok: ${logical}"
	return 0
}

function native_inputs() {
	local rc=0 file path drop mods name
	native_report_file /usr/local/bin/svxlink || rc=1
	path=$(native_path /usr/local/bin/svxlink)
	if [ -f "$path" ] && [ ! -L "$path" ] && [ ! -x "$path" ]; then
		echo "missing: /usr/local/bin/svxlink is not executable"
		rc=1
	fi
	native_report_dir /usr/local/lib/svxlink || rc=1
	for file in RepeaterLogic.so SimplexLogic.so DummyLogic.so; do
		native_report_file "/usr/local/lib/svxlink/${file}" || rc=1
	done
	path=$(native_path /usr/local/lib/svxlink)
	if [ -d "$path" ] && [ ! -L "$path" ]; then
		mods=$(find -P "$path" -maxdepth 1 -type f -name 'Module*.so' | wc -l | tr -d ' ')
		echo "note: ${mods} Module*.so files are installed and are not named by the test config"
	fi
	native_report_file /usr/local/share/svxlink/events.tcl || rc=1
	native_report_dir /usr/local/share/svxlink/events.d || rc=1
	path=$(native_path /usr/local/share/svxlink/events.d)
	if [ -d "$path" ] && [ ! -L "$path" ] && find -P "$path" -xdev -type l -print | grep -q .; then
		echo "missing: /usr/local/share/svxlink/events.d contains a symbolic link"
		rc=1
	fi
	for file in globals.tcl squelch_timeout.tcl Module.tcl CW.tcl SelCall.tcl locale.tcl \
		LogicBase.tcl Logic.tcl SimplexLogicType.tcl RepeaterLogicType.tcl \
		ReflectorLogicType.tcl ReflectorV2LogicType.tcl SimplexLogic.tcl \
		RepeaterLogic.tcl ReflectorLogic.tcl
	do
		native_report_file "/usr/local/share/svxlink/events.d/${file}" || rc=1
	done
	native_report_dir /usr/local/share/svxlink/sounds || rc=1
	path=$(native_path /usr/local/share/svxlink/sounds/en_US)
	if [ -d "$path" ] && [ ! -L "$path" ]; then
		echo "ok: /usr/local/share/svxlink/sounds/en_US"
	else
		echo "note: /usr/local/share/svxlink/sounds/en_US is absent. Speech clips are not this lifecycle slice."
	fi
	native_report_dir /etc/svxlink || rc=1
	drop=$(native_path /etc/svxlink/svxlink.d)
	if [ -d "$drop" ] && [ ! -L "$drop" ]; then
		echo "note: /etc/svxlink/svxlink.d is not the disconnected-test CFG_DIR"
		find -P "$drop" -maxdepth 1 -type f -name '*.conf' | while IFS= read -r name; do
			echo "note: leaving $(basename "$name") in svxlink.d"
		done
	elif [ -L "$drop" ]; then
		echo "missing: /etc/svxlink/svxlink.d is a symbolic link"
		rc=1
	fi
	return "$rc"
}

function native_account_ok() {
	if [ -n "${ORP_ROOT:-}" ]; then
		[ -f "${ORP_ROOT}/etc/passwd" ] && [ -f "${ORP_ROOT}/etc/group" ] \
			&& grep -q '^svxlink:' "${ORP_ROOT}/etc/passwd" \
			&& grep -q '^svxlink:' "${ORP_ROOT}/etc/group"
		return $?
	fi
	getent passwd svxlink >/dev/null && getent group svxlink >/dev/null
}

function native_service_path() {
	local logical=$1 kind=${2:-dir} path owner
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ "$kind" = "dir" ] && [ ! -d "$path" ]; then
		echo "missing: ${logical} is not a directory"
		return 1
	fi
	if [ "$kind" = "file" ] && [ ! -f "$path" ]; then
		echo "missing: ${logical} is not a regular file"
		return 1
	fi
	if [ ! -e "$path" ]; then
		echo "missing: ${logical} is absent"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_harness; then
		owner=$(stat -c '%U:%G' "$path")
		if [ "$owner" != "svxlink:svxlink" ]; then
			echo "missing: ${logical} is ${owner}, expected svxlink:svxlink"
			return 1
		fi
	fi
	echo "ok: ${logical}"
	return 0
}

function native_unit_text() {
	cat <<'EOF'
[Unit]
Description=SvxLink repeater control software
Documentation=man:svxlink(1) man:svxlink.conf(5)
After=network.target

[Service]
Type=simple
User=svxlink
Group=svxlink
UMask=0022
WorkingDirectory=/etc/svxlink
ExecStart=/usr/local/bin/svxlink --logfile=/var/log/svxlink --config=/etc/svxlink/svxlink.conf
Restart=no
TimeoutStopSec=10
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
}

function native_runtime() {
	local rc=0 path expected
	if native_account_ok; then
		echo "ok: user svxlink"
	else
		echo "missing: user and group svxlink"
		rc=1
	fi
	native_service_path /var/lib/svxlink dir || rc=1
	native_service_path /var/spool/svxlink dir || rc=1
	native_service_path /var/log/svxlink file || rc=1
	path=$(native_path /usr/local/lib/systemd/system/svxlink.service)
	if [ -L "$path" ] || [ ! -f "$path" ]; then
		echo "missing: /usr/local/lib/systemd/system/svxlink.service is not a regular file"
		rc=1
	elif ! native_root_owned "$path" || native_open_mode "$path"; then
		echo "missing: vendor svxlink.service is not a root-owned private file"
		rc=1
	else
		expected=$(mktemp)
		native_unit_text > "$expected"
		if cmp -s "$expected" "$path"; then
			echo "ok: /usr/local/lib/systemd/system/svxlink.service"
		else
			echo "missing: vendor svxlink.service does not match the reviewed unit"
			rc=1
		fi
		rm -f "$expected"
	fi
	return "$rc"
}

function native_masks() {
	local rc=0 unit path
	for unit in svxlink.service remotetrx.service svxreflector.service; do
		path=$(native_path "/etc/systemd/system/${unit}")
		if [ -L "$path" ] && [ "$(readlink "$path")" = "/dev/null" ]; then
			echo "ok: ${unit} -> /dev/null"
		else
			echo "missing: ${unit} is not a /dev/null mask"
			rc=1
		fi
	done
	return "$rc"
}

function native_preflight() {
	local rc=0
	native_inputs || rc=1
	native_runtime || rc=1
	native_masks || rc=1
	return "$rc"
}

function native_start_blocked() {
	local path
	path=$(native_path /etc/systemd/system/svxlink.service)
	if [ ! -e "$path" ] && [ ! -L "$path" ]; then
		return 1
	fi
	if [ -L "$path" ] && [ "$(readlink "$path")" = "/dev/null" ]; then
		echo "refused: svxlink.service is masked. Unmask was not performed. Start was not called."
		return 0
	fi
	echo "refused: /etc/systemd/system/svxlink.service is not the administrative mask. Start was not called."
	return 0
}

function config_event_handler() {
	local path
	path=$(native_path /usr/local/share/svxlink/events.tcl)
	config_real_file "$path" || return 1
	printf '%s' /usr/local/share/svxlink/events.tcl
}

function config_module_dir() {
	local path
	path=$(native_path /usr/local/lib/svxlink)
	[ -d "$path" ] && [ ! -L "$path" ] || return 1
	config_real_file "${path}/RepeaterLogic.so" || return 1
	printf '%s' /usr/local/lib/svxlink
}

function config_callsign() {
	local db value
	db="${ORP_DB_PATH:-${ORP_ROOT:-}/var/lib/openrepeater/db/openrepeater.db}"
	config_real_file "$db" || return 1
	value=$(sqlite3 "$db" "SELECT value FROM settings WHERE keyID='callSign';") || return 1
	case "$value" in
		*[!A-Z0-9]*|"") return 1 ;;
	esac
	local len=${#value}
	[ "$len" -ge 3 ] && [ "$len" -le 12 ] || return 1
	printf '%s' "$value"
}

function config_ancestors_real() {
	local path=$1 acc="" part rest
	case "$path" in
		/*) ;;
		*) return 1 ;;
	esac
	rest=${path#/}
	while [ -n "$rest" ]; do
		part=${rest%%/*}
		if [ "$rest" = "$part" ]; then
			rest=""
		else
			rest=${rest#*/}
		fi
		[ -n "$part" ] || continue
		acc="${acc}/${part}"
		if [ -L "$acc" ]; then
			echo "refused: symbolic link at ${acc}" >&2
			return 1
		fi
		if [ -n "$rest" ] && [ ! -d "$acc" ]; then
			echo "refused: missing directory ${acc}" >&2
			return 1
		fi
	done
	return 0
}

function config_parent_anchored() {
	local parent=$1
	[ -d "$parent" ] && [ ! -L "$parent" ] || return 1
	if find "$parent" -maxdepth 0 -perm /022 | grep -q .; then
		echo "refused: ${parent} is group or world writable" >&2
		return 1
	fi
	return 0
}

function config_render() {
	local out=$1 callsign events modules
	callsign=$(config_callsign) || return 1
	events=$(config_event_handler) || return 1
	modules=$(config_module_dir) || return 1
	cat > "$out" <<EOF
[GLOBAL]
MODULE_PATH=${modules}
LOGIC_CORE_PATH=${modules}
LOGICS=RepeaterLogic
CFG_DIR=/etc/svxlink/functional-test.d
TIMESTAMP_FORMAT="%c"
CARD_SAMPLE_RATE=16000
[RepeaterLogic]
TYPE=Repeater
RX=Rx1
TX=Tx1
CALLSIGN=${callsign}
SHORT_IDENT_INTERVAL=10
LONG_IDENT_INTERVAL=0
IDENT_ONLY_AFTER_TX=0
EVENT_HANDLER=${events}
SHORT_VOICE_ID_ENABLE=1
SHORT_CW_ID_ENABLE=0
LONG_VOICE_ID_ENABLE=1
LONG_CW_ID_ENABLE=0
[Rx1]
TYPE=Local
AUDIO_DEV=udp:127.0.0.1:17001
AUDIO_CHANNEL=0
SQL_DET=SIGLEV
SQL_START_DELAY=1
SQL_DELAY=40
SIGLEV_SLOPE=1
SIGLEV_OFFSET=0
SQL_SIGLEV_OPEN_THRESH=30
SQL_SIGLEV_CLOSE_THRESH=10
[Tx1]
TYPE=Local
AUDIO_DEV=udp:127.0.0.1:17002
AUDIO_CHANNEL=0
PTT_TYPE=NONE
EOF
}

function config_dest() {
	printf '%s' "${ORP_ROOT:-}/etc/svxlink/svxlink.conf"
}

function config_matches_snapshot() {
	local dest expected
	dest=$(config_dest)
	expected=$(mktemp)
	if ! config_render "$expected"; then
		rm -f "$expected"
		return 1
	fi
	cmp -s "$expected" "$dest"
	local rc=$?
	rm -f "$expected"
	return "$rc"
}

function config_publish {
	local dest parent snapshot backup sum_before sum_after
	if ! functional_test_on; then
		echo "refused: config publish requires functional-test"
		return 1
	fi
	# Deliberately ignore ORP_STAGED_CONFIG and the preview file.
	if ! config_callsign >/dev/null; then
		echo "refused: stored call sign is not a plain station token. It was not changed and was not published."
		return 1
	fi
	if ! native_inputs; then
		echo "refused: installed SvxLink layout is incomplete. Stored wiring was not changed."
		return 1
	fi
	dest=$(config_dest)
	parent=$(dirname "$dest")
	if ! config_ancestors_real "$parent"; then
		return 1
	fi
	if ! config_parent_anchored "$parent"; then
		return 1
	fi
	if [ -L "$dest" ] || [ -L "${parent}/svxlink.d" ] || [ -L "${parent}/functional-test.d" ]; then
		echo "refused: live svxlink path is a symbolic link"
		return 1
	fi
	if [ -e "${parent}/functional-test.d" ] && [ ! -d "${parent}/functional-test.d" ]; then
		echo "refused: functional-test.d is not a directory"
		return 1
	fi
	if [ ! -d "${parent}/functional-test.d" ]; then
		mkdir -m 755 "${parent}/functional-test.d"
	fi
	if native_open_mode "${parent}/functional-test.d"; then
		echo "refused: functional-test.d is group or world writable"
		return 1
	fi
	if find -P "${parent}/functional-test.d" -mindepth 1 -print | grep -q .; then
		echo "refused: functional-test.d is not empty. Sample svxlink.d files were not copied."
		return 1
	fi
	snapshot=$(mktemp "${parent}/.orp-svxlink.XXXXXX")
	if ! config_render "$snapshot"; then
		rm -f "$snapshot"
		echo "refused: disconnected-test config was not rendered"
		return 1
	fi
	sum_before=$(sha256sum "$snapshot" | awk '{print $1}')
	if [ -f "$dest" ]; then
		backup="${ORP_ROOT:-}/var/backups/orp-ui/functional-test-$(date -u +%Y%m%dT%H%M%SZ)"
		if ! config_ancestors_real "$(dirname "$backup")"; then
			rm -f "$snapshot"
			return 1
		fi
		mkdir -p "$backup"
		cp -p "$dest" "$backup/svxlink.conf"
	fi
	mv -f "$snapshot" "$dest"
	chmod 644 "$dest"
	sum_after=$(sha256sum "$dest" | awk '{print $1}')
	if [ "$sum_before" != "$sum_after" ]; then
		echo "refused: published bytes did not match the rendered snapshot"
		return 1
	fi
	echo "published ${dest}"
	echo "snapshot=${sum_after}"
	echo "runtime=simulation/dummy-path PTT_TYPE=NONE loopback-udp"
	echo "gpio=not-applied"
	echo "event=$(config_event_handler)"
	echo "stored wiring was not modified"
	echo "service was not started"
}

function system_reboot {
	if functional_test_on; then
		echo "refused: host reboot stays blocked in functional-test"
		return 1
	fi
	if bench_refuses "system restart"; then
		return 1
	fi
	shutdown -r now
}

function system_shutdown {
	if functional_test_on; then
		echo "refused: host shutdown stays blocked in functional-test"
		return 1
	fi
	if bench_refuses "system stop"; then
		return 1
	fi
	shutdown -h now
}

function system_uptime {
	uptime
}

function system_user {
	whoami
}


### AUDIO FUNCTIONS ###
function audio_inputs {
	arecord -l
}

function audio_outputs {
	aplay -l
}

function audio_version {
	cat /proc/asound/version 2>&1
}


### AUDIO FUNCTIONS ###
function set_mixer {
	if bench_refuses "set_mixer"; then
		return 1
	fi
	if [ -n "$3" ]; then
		amixer -c$3 set "$1" $2
	else
		amixer set "$1" $2
	fi
}

function alsamixer_backup {
	if bench_refuses "alsa backup"; then
		return 1
	fi
	if ! alsa_state_allowed "$1"; then
		return 1
	fi
	if ! alsactl --file "$1" store; then
		echo "refused: alsactl store failed"
		return 1
	fi
	if ! alsa_state_allowed "$1"; then
		return 1
	fi
	chown www-data:www-data "$1"
}

function alsamixer_restore {
	if bench_refuses "alsa restore"; then
		return 1
	fi
	alsactl --file "$1" restore
}


### NETWORK FUNCTIONS ###
function network_read {
	echo "Read Network Config for external parsing"
}

function network_write {
	echo "Write New Network Config"
}


### WEBSERVER FUNCTIONS ###
function www_stop {
	echo "Webserver / ORP GUI Stop"
	service nginx stop
}

function www_start {
	echo "Webserver / ORP GUI Start"
	service nginx start
}

function www_restart {
	echo "Webserver / ORP GUI Restart"
	service nginx restart
}

function www_disable {
	echo "Webserver / ORP GUI Disable"
	systemctl disable nginx
}

function www_enable {
	echo "Webserver / ORP GUI Enable"
	systemctl enable nginx
	service nginx restart
}



### INFO FUNCTIONS ###
function info_timezone {
	cat /etc/timezone
}

function info_cpu_type {
	cat /proc/cpuinfo | grep processor
}

function info_cpu_speed {
	cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
}

function info_cpu_load {
	{ head -n1 /proc/stat;sleep 0.2;head -n1 /proc/stat; } | awk '/^cpu /{u=$2-u;s=$4-s;i=$5-i;w=$6-w}END{print int(0.5+100*(u+s+w)/(u+s+i+w))}'
}

function info_cpu_temp {
	cat /sys/class/thermal/thermal_zone0/temp
}

function info_uptime {
	cat /proc/uptime
}

function info_memory_usage {
	cat /proc/meminfo
}

function info_disk_usage {
	df -T -l -BM -x tmpfs -x devtmpfs -x rootfs -x vfat
}

function info_os {
	uname -a
}

# TODO LIST
# Setting Timezone
# Expanding Filesystem


###############################################################################
# READ COMMAND LINE OPTIONS AND EXECUTE (Calls Functions Above)
###############################################################################

while :; do
    if [ "${2:-}" = "unmask" ]; then
        echo "refused: unmask is not permitted"
        exit 1
    fi
    case $1 in
        config)
			if [ "$2" == "publish" ]; then config_publish
			else echo "INVALID OPTION"; echo "USAGE: orp_helper config publish"
			fi
			exit;;
        native)
			if [ "$2" == "preflight" ]; then native_preflight
			elif [ "$2" == "inputs" ]; then native_inputs
			elif [ "$2" == "unit" ]; then native_unit_text
			else echo "INVALID OPTION"; echo "USAGE: orp_helper native (preflight|inputs|unit)"
			fi
			exit;;
        svxlink)
			if [ "$2" == "start" ]; then svxlink_start
			elif [ "$2" == "stop" ]; then svxlink_stop
			elif [ "$2" == "restart" ]; then svxlink_restart
			elif [ "$2" == "status" ]; then svxlink_status
			elif [ "$2" == "enable" ]; then svxlink_enable
			elif [ "$2" == "disable" ]; then svxlink_disable
			elif [ "$2" == "gpio_up" ]; then svxlink_gpio_up
			elif [ "$2" == "gpio_down" ]; then svxlink_gpio_down
			else echo "INVALID OPTION"; echo "USAGE: orp_helper svxlink (start|stop|restart|status|enable|disable|gpio_up|gpio_down)"
			fi
			exit;;
        system)
			if [ "$2" == "stop" ]; then system_shutdown
			elif [ "$2" == "restart" ]; then system_reboot
			elif [ "$2" == "uptime" ]; then system_uptime
			elif [ "$2" == "user" ]; then system_user
			else echo "INVALID OPTION"; echo "USAGE: orp_helper system (stop|restart|uptime|user)"
			fi
			exit;;
        info)
			if [ "$2" == "timezone" ]; then info_timezone
			elif [ "$2" == "cpu_type" ]; then info_cpu_type
			elif [ "$2" == "cpu_speed" ]; then info_cpu_speed
			elif [ "$2" == "cpu_load" ]; then info_cpu_load
			elif [ "$2" == "cpu_temp" ]; then info_cpu_temp
			elif [ "$2" == "uptime" ]; then info_uptime
			elif [ "$2" == "memory_usage" ]; then info_memory_usage
			elif [ "$2" == "disk_usage" ]; then info_disk_usage
			elif [ "$2" == "os" ]; then info_os
			else echo "INVALID OPTION"; echo "USAGE: orp_helper info (timezone|cpu_type|cpu_speed|cpu_load|cpu_temp|uptime|memory_usage|disk_usage|os)"
			fi
			exit;;
#info_uptime
        www)
			if [ "$2" == "stop" ]; then www_stop
			elif [ "$2" == "start" ]; then www_start
			elif [ "$2" == "restart" ]; then www_restart
			elif [ "$2" == "disable" ]; then www_disable
			elif [ "$2" == "enable" ]; then www_enable
			else echo "INVALID OPTION"; echo "USAGE: orp_helper www (stop|start|restart|disable|enable)"
			fi
			exit;;
        audio)
			if [ "$2" == "inputs" ]; then audio_inputs
			elif [ "$2" == "outputs" ]; then audio_outputs
			elif [ "$2" == "version" ]; then audio_version
			else echo "INVALID OPTION"; echo "USAGE: orp_helper audio (inputs|outputs|version)"
			fi
			exit;;
        set_mixer)
			if [[ -n "$2" && -n "$3" && -n "$4" ]]; then set_mixer "$2" "$3" "$4"
			elif [[ -n "$2" && -n "$3" ]]; then set_mixer "$2" "$3"
			else echo "INVALID OPTION"; echo "USAGE: orp_helper set_mixer (setting) (value) [OPTIONAL: device]"
			fi
			exit;;
        alsa)
			if [ "$2" == "backup" ]; then alsamixer_backup "$3"
			elif [ "$2" == "restore" ]; then alsamixer_restore "$3"
			else echo "INVALID OPTION"; echo "USAGE: orp_helper alsa (backup|restore) [path]"
			fi
			exit;;
        network)
			if [ "$2" == "read" ]; then network_read
			elif [ "$2" == "write" ]; then network_write
			else echo "INVALID OPTION"; echo "USAGE: orp_helper network (read|write)"
			fi
			exit;;

        TEST)
			echo "Testing..."
			exit;;

        -h|-\?|--help|*)   # Display general help/info.
			display_help
			exit;;
    esac
done