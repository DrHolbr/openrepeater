#!/bin/bash
# Copyright ©2017 OpenRepeater Project - Aaron Crawford, N3MBH & Richard Neese KB3VGW
# Licended under GPL v2 or later

# This is a helper script for OpenRepeater. This script is primarily intended
# to extend the functionality of the of the ORP web user interface and allow it
# to execute specific system commands that it would not normally be able to
# perform due to security reasons in Linux. DO NOT INCLUDE commands in this
# script that a potential hacker could utilize to compromise the system if the
# web server were to be compromised. This script should be a delicate balance
# between needed functionality in the web interface and security. 

# NOTE: NO NEED TO PREFIX COMMANDS WITH SUDO AS THIS SCRIPT IS INTENDED TO BE RUN AS ROOT USING SUDO COMMAND

####### WORK IN PROGRESS........

###############################################################################
# DEFINE FUNCTIONS
###############################################################################

### SVXLINK FUNCTIONS ###
function display_help {
	echo "OPEN REPEATER HELPER"
	echo "This is a helper script for OpenRepeater. This script is primarily intended"
	echo "to extend the functionality of the of the ORP web user interface and allow it"
	echo "to execute specific system commands that it would not normally be able to"
	echo "perform due to security reasons in Linux."
	echo ""
	echo "USAGE: orp_helper [service] [option]"
}

function bench_test_harness {
	[ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]
}

function harness_path_allowed() {
	case "$1" in
		/etc|/etc/*|/usr|/usr/*|/var/www|/var/www/*|/var/lib/openrepeater|/var/lib/openrepeater/*)
			return 1
			;;
	esac
	case "$1" in
		*..*) return 1 ;;
	esac
	return 0
}

function bench_marker_path {
	if bench_test_harness; then
		if [ -n "${ORP_BENCH_MARKER:-}" ] && harness_path_allowed "$ORP_BENCH_MARKER"; then
			printf '%s' "$ORP_BENCH_MARKER"
		else
			printf '%s' "${TMPDIR:-/tmp}/orp-no-such-bench-marker"
		fi
	else
		printf '%s' /etc/openrepeater/bench-mode
	fi
}

function bench_hostname {
	local file=/etc/hostname
	if bench_test_harness; then
		if [ -n "${ORP_BENCH_HOSTNAME_FILE:-}" ] && harness_path_allowed "$ORP_BENCH_HOSTNAME_FILE"; then
			file=$ORP_BENCH_HOSTNAME_FILE
		else
			printf '%s' ""
			return
		fi
	fi
	if [ -f "$file" ]; then
		tr -d '[:space:]' < "$file"
	fi
}

function operating_mode_file {
	if bench_test_harness; then
		if [ -n "${ORP_OPERATING_MODE_FILE:-}" ] && harness_path_allowed "$ORP_OPERATING_MODE_FILE"; then
			printf '%s' "$ORP_OPERATING_MODE_FILE"
		else
			printf '%s' "${TMPDIR:-/tmp}/orp-no-such-operating-mode"
		fi
	else
		printf '%s' /etc/openrepeater/operating-mode
	fi
}

function operating_mode_token {
	local file perm owner token
	file=$(operating_mode_file)
	[ -f "$file" ] || return 0
	[ -L "$file" ] && return 0
	perm=$(stat -c %a "$file")
	# Reject group or other write. stat %a is decimal, so use the permission bits.
	if find "$file" -perm /022 | grep -q .; then
		return 0
	fi
	if ! bench_test_harness; then
		owner=$(stat -c %u "$file")
		[ "$owner" = 0 ] || return 0
	fi
	token=$(tr -d '[:space:]' < "$file")
	case "$token" in
		bench|functional-test) printf '%s' "$token" ;;
	esac
}

function functional_test_on {
	[ "$(operating_mode_token)" = "functional-test" ]
}

function bench_mode_on {
	# functional-test is not bench. A missing or untrusted mode file does
	# not turn hostname orp-test into legacy operation.
	local token
	token=$(operating_mode_token)
	if [ "$token" = "functional-test" ]; then
		return 1
	fi
	if [ "$token" = "bench" ]; then
		return 0
	fi
	if [ "$(bench_hostname)" = "orp-test" ]; then
		return 0
	fi
	[ -f "$(bench_marker_path)" ]
}

function drive_refuses {
	# GPIO and PTT run only when the trusted token and the root-only
	# tx-armed flag are both present. The installer does not create the flag.
	# This mode assumes no radio is attached.
	if native_functional_token && tx_armed; then
		return 1
	fi
	if functional_test_on || bench_mode_on || native_functional_token; then
		echo "refused: GPIO and PTT setup stay blocked ($1). This is not a service start and not proof a transmitter unkeyed."
		return 0
	fi
	return 1
}

function alsa_state_allowed {
	local path=$1 build restore
	# Harness runs resolve these through the fixture root. Production keeps
	# the two live backup paths. Root still does not open a symlink.
	build=$(module_root_path /var/www/openrepeater/backup/build/alsamixer.state)
	restore=$(module_root_path /var/www/openrepeater/backup/restore/alsamixer.state)
	if [ "$path" != "$build" ] && [ "$path" != "$restore" ]; then
		echo "refused: alsa path is outside the backup directory"
		return 1
	fi
	if [ -L "$path" ]; then
		echo "refused: alsa state path is a symlink"
		return 1
	fi
	return 0
}

function bench_refuses {
	if native_functional_token; then
		return 1
	fi
	if bench_mode_on; then
		echo "refused: bench mode blocks $1"
		return 0
	fi
	return 1
}

# start, stop, restart, enable, disable, and unmask for the three radio
# units. Allowed only with the trusted functional-test token. The harness
# records the call and does not touch the host.
function radio_unit_ctl {
	local unit=$1 action=$2
	case "$unit" in
		svxlink|remotetrx|svxreflector) ;;
		*)
			echo "refused: ${unit} is not a radio unit"
			return 1
			;;
	esac
	case "$action" in
		start|stop|restart|enable|disable|unmask) ;;
		*)
			echo "refused: ${action} is not a radio action"
			return 1
			;;
	esac
	# enable stays blocked for svxlink, remotetrx, and svxreflector.
	# start, stop, and restart stay available with the trusted token.
	if [ "$action" = "enable" ]; then
		echo "refused: ${unit} enable stays blocked. Start, stop, and restart stay available."
		return 1
	fi
	if ! native_functional_token; then
		echo "refused: ${unit} ${action} requires a trusted functional-test token"
		return 1
	fi
	if [ "$action" = "start" ] || [ "$action" = "restart" ]; then
		if ! tx_transmit_allowed "$unit"; then
			return 1
		fi
	fi
	if [ "$action" = "unmask" ]; then
		radio_unit_unmask "$unit"
		return $?
	fi
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
		if [ -n "${ORP_SYSTEMCTL:-}" ]; then
			"${ORP_SYSTEMCTL}" "$action" "${unit}.service"
			return $?
		fi
		echo "harness: ${unit} ${action}"
		return 0
	fi
	systemctl "$action" "${unit}.service"
}

# A missing file has no PTT_TYPE lines and is treated as disconnected.
# A symlink is refused. allowed_re matches the whole PTT_TYPE line.
function ptt_lines_are() {
	local file=$1 allowed_re=$2
	if [ ! -e "$file" ]; then
		return 0
	fi
	if [ -L "$file" ] || [ ! -f "$file" ]; then
		echo "refused: ${file} is not a regular file. Start was not called."
		return 1
	fi
	if grep -E '^PTT_TYPE=' "$file" | grep -E -qv "$allowed_re"; then
		return 1
	fi
	return 0
}

# Unarmed svxlink start/restart requires a disconnected snapshot.
# Unarmed remotetrx start/restart requires every PTT_TYPE to be NONE or Dummy.
function tx_transmit_allowed() {
	local unit=$1 dest
	if tx_armed; then
		return 0
	fi
	case "$unit" in
		svxlink)
			dest=$(config_dest)
			if ! ptt_lines_are "$dest" '^PTT_TYPE=NONE$'; then
				echo "refused: svxlink.conf has a PTT_TYPE other than NONE. Start was not called."
				return 1
			fi
			if ! config_matches_snapshot; then
				echo "refused: svxlink.conf is not the disconnected-test snapshot. Start was not called."
				return 1
			fi
			;;
		remotetrx)
			dest=$(native_path /etc/svxlink/remotetrx.conf)
			if ! ptt_lines_are "$dest" '^PTT_TYPE=(NONE|Dummy)$'; then
				echo "refused: remotetrx.conf has a PTT_TYPE other than NONE or Dummy. Start was not called."
				return 1
			fi
			;;
	esac
	return 0
}

function radio_unit_systemctl() {
	local action=$1 unit=$2
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
		if [ -n "${ORP_SYSTEMCTL:-}" ]; then
			"${ORP_SYSTEMCTL}" "$action" "${unit}.service"
			return $?
		fi
		echo "harness: ${unit} ${action}"
		return 0
	fi
	systemctl "$action" "${unit}.service"
}

# unmask also disables the unit, deletes wants/requires/upholds links, and
# requires is-enabled=disabled. It does not start the unit.
function radio_unit_unmask() {
	local unit=$1 sys enabled
	radio_unit_systemctl unmask "$unit" || true
	radio_unit_systemctl disable "$unit" || true
	sys=$(native_path /etc/systemd/system)
	if [ -d "$sys" ]; then
		find -P "$sys" -xdev -type l -name "${unit}.service" \
			\( -path '*wants/*' -o -path '*requires/*' -o -path '*upholds/*' \) -delete
	fi
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ] && [ -z "${ORP_SYSTEMCTL:-}" ]; then
		enabled=disabled
	else
		enabled=$(radio_unit_systemctl is-enabled "$unit" 2>/dev/null || true)
	fi
	case "$enabled" in
		disabled|not-found)
			echo "is-enabled=disabled ${unit}.service"
			;;
		*)
			echo "refused: ${unit}.service is-enabled=${enabled:-empty}, expected disabled"
			return 1
			;;
	esac
}

function svxlink_disable {
	echo "SVXLink Disable"
	service svxlink stop
	systemctl disable svxlink.service
}

function svxlink_enable {
	# Functional-test refuses enable for svxlink even when the trusted
	# token lifts start, stop, and restart.
	if functional_test_on || native_functional_token; then
		echo "refused: svxlink enable stays blocked in functional-test. Start, stop, and restart stay available."
		return 1
	fi
	if bench_refuses "svxlink enable"; then
		return 1
	fi
	echo "SVXLink Enable"
	systemctl enable svxlink.service
	service svxlink start
}

function svxlink_service_ctl {
	local action=$1
	local rc
	if [ "$action" = "start" ] || [ "$action" = "restart" ]; then
		if ! config_matches_snapshot; then
			echo "refused: svxlink.conf is not the disconnected-test snapshot. Start was not called."
			return 1
		fi
		if ! native_inputs >/dev/null || ! native_runtime >/dev/null; then
			echo "refused: native preflight failed. Start was not called."
			native_inputs || true
			native_runtime || true
			return 1
		fi
		if native_start_blocked; then
			return 1
		fi
	fi
	# Never unmask. A masked unit is service-disabled, which is separate
	# from an unresolved GPIO number and from the dummy audio path.
	if [ -n "${ORP_SYSTEMCTL:-}" ]; then
		"${ORP_SYSTEMCTL}" "$action" svxlink.service
		return $?
	fi
	systemctl "$action" svxlink.service
	rc=$?
	if systemctl is-enabled svxlink.service 2>/dev/null | grep -q '^masked$'; then
		echo "service-disabled: svxlink.service is masked. Unmask was not performed."
		return "$rc"
	fi
	systemctl is-active svxlink.service || true
	return "$rc"
}

function svxlink_restart {
	if native_functional_token; then
		radio_unit_ctl svxlink restart
		return $?
	fi
	if functional_test_on; then
		svxlink_service_ctl restart
		return $?
	fi
	if bench_refuses "svxlink restart"; then
		return 1
	fi
	service svxlink restart
	svxlink_status
}

function svxlink_stop {
	if native_functional_token; then
		radio_unit_ctl svxlink stop
		return $?
	fi
	if functional_test_on; then
		svxlink_service_ctl stop
		return $?
	fi
	if bench_refuses "svxlink stop"; then
		return 1
	fi
	service svxlink stop
	svxlink_status
}

function svxlink_start {
	# With the tx-armed flag, a trusted token starts the unit directly and
	# skips config_matches_snapshot and native_start_blocked. Without the
	# flag, radio_unit_ctl still refuses start unless the live file matches
	# the disconnected snapshot and every PTT_TYPE is NONE. Those checks
	# also run when the mode file is functional-test but the token is not
	# trusted. svxlink_gpio_up executes /usr/sbin/svxlink_gpio_up; it does
	# not source that file. This tree does not ship the binary.
	if native_functional_token; then
		radio_unit_ctl svxlink start
		return $?
	fi
	if functional_test_on; then
		svxlink_service_ctl start
		return $?
	fi
	if bench_refuses "svxlink start"; then
		return 1
	fi
	service svxlink start
	svxlink_status
}

function svxlink_status {
	systemctl is-active svxlink
}

function svxlink_gpio_up {
	if drive_refuses "svxlink gpio_up"; then
		return 1
	fi
	"${SVXLINK_GPIO_UP_BIN:-/usr/sbin/svxlink_gpio_up}"
	echo up
}

function svxlink_gpio_down {
	if drive_refuses "svxlink gpio_down"; then
		return 1
	fi
	"${SVXLINK_GPIO_DOWN_BIN:-/usr/sbin/svxlink_gpio_down}"
	echo down
}


### SYSTEM FUNCTIONS ###
# The web process never supplies this file. Without /etc/openrepeater/tx-armed,
# root renders the disconnected-test document and does not read the preview
# file or ORP_STAGED_CONFIG. With that root-only flag, www-data cats the staged
# file into a root snapshot. Root does not open the staged path and does not
# use cp -p.
function config_real_file() {
	local path=$1
	[ -f "$path" ] && [ ! -L "$path" ]
}

# Source build on orp-test: prefix /usr/local, SYSCONF_INSTALL_DIR=/etc,
# libraries in /usr/local/lib (not the multiarch distro directories).
# ORP_ROOT is a fixture prefix. The text written into svxlink.conf stays
# the real absolute path the process opens.
# Strip trailing slashes. "/" and "//" are empty so they cannot prefix a
# relative join into the live /etc tree.
function orp_root_prefix() {
	local root=${ORP_ROOT:-}
	while [ -n "$root" ] && [ "${root%/}" != "$root" ]; do
		root=${root%/}
	done
	case "$root" in
		""|/) return 1 ;;
	esac
	printf '%s' "$root"
}

function native_path() {
	local root
	if root=$(orp_root_prefix); then
		printf '%s%s' "$root" "$1"
		return 0
	fi
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
		harness_note_live_etc "$1"
		printf '%s' "${TMPDIR:-/tmp}/orp-harness-blocked$1"
		return 0
	fi
	printf '%s' "$1"
}

function native_harness() {
	[ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]
}

function native_open_mode() {
	find "$1" -maxdepth 0 -perm /022 | grep -q .
}

function native_root_owned() {
	if native_harness; then
		return 0
	fi
	[ "$(stat -c '%u:%g' "$1")" = "0:0" ]
}

function native_report_file() {
	local logical=$1 path
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ ! -f "$path" ]; then
		echo "missing: ${logical} is not a regular file"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_root_owned "$path"; then
		echo "missing: ${logical} is not root:root"
		return 1
	fi
	echo "ok: ${logical}"
	return 0
}

function native_report_dir() {
	local logical=$1 path
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ ! -d "$path" ]; then
		echo "missing: ${logical} is not a directory"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_root_owned "$path"; then
		echo "missing: ${logical} is not root:root"
		return 1
	fi
	echo "ok: ${logical}"
	return 0
}

function native_inputs() {
	local rc=0 file path drop mods name
	native_report_file /usr/local/bin/svxlink || rc=1
	path=$(native_path /usr/local/bin/svxlink)
	if [ -f "$path" ] && [ ! -L "$path" ] && [ ! -x "$path" ]; then
		echo "missing: /usr/local/bin/svxlink is not executable"
		rc=1
	fi
	native_report_dir /usr/local/lib/svxlink || rc=1
	for file in RepeaterLogic.so SimplexLogic.so DummyLogic.so; do
		native_report_file "/usr/local/lib/svxlink/${file}" || rc=1
	done
	path=$(native_path /usr/local/lib/svxlink)
	if [ -d "$path" ] && [ ! -L "$path" ]; then
		mods=$(find -P "$path" -maxdepth 1 -type f -name 'Module*.so' | wc -l | tr -d ' ')
		echo "note: ${mods} Module*.so files are installed and are not named by the test config"
	fi
	native_report_file /usr/local/share/svxlink/events.tcl || rc=1
	native_report_dir /usr/local/share/svxlink/events.d || rc=1
	path=$(native_path /usr/local/share/svxlink/events.d)
	if [ -d "$path" ] && [ ! -L "$path" ] && find -P "$path" -xdev -type l -print | grep -q .; then
		echo "missing: /usr/local/share/svxlink/events.d contains a symbolic link"
		rc=1
	fi
	for file in globals.tcl squelch_timeout.tcl Module.tcl CW.tcl SelCall.tcl locale.tcl \
		LogicBase.tcl Logic.tcl SimplexLogicType.tcl RepeaterLogicType.tcl \
		ReflectorLogicType.tcl ReflectorV2LogicType.tcl SimplexLogic.tcl \
		RepeaterLogic.tcl ReflectorLogic.tcl
	do
		native_report_file "/usr/local/share/svxlink/events.d/${file}" || rc=1
	done
	native_report_dir /usr/local/share/svxlink/sounds || rc=1
	path=$(native_path /usr/local/share/svxlink/sounds/en_US)
	if [ -d "$path" ] && [ ! -L "$path" ]; then
		echo "ok: /usr/local/share/svxlink/sounds/en_US"
	else
		echo "note: /usr/local/share/svxlink/sounds/en_US is absent. Speech clips are not this lifecycle slice."
	fi
	native_report_dir /etc/svxlink || rc=1
	drop=$(native_path /etc/svxlink/svxlink.d)
	if [ -d "$drop" ] && [ ! -L "$drop" ]; then
		echo "note: /etc/svxlink/svxlink.d is not the disconnected-test CFG_DIR"
		find -P "$drop" -maxdepth 1 -type f -name '*.conf' | while IFS= read -r name; do
			echo "note: leaving $(basename "$name") in svxlink.d"
		done
	elif [ -L "$drop" ]; then
		echo "missing: /etc/svxlink/svxlink.d is a symbolic link"
		rc=1
	fi
	return "$rc"
}

function native_account_ok() {
	if [ -n "${ORP_ROOT:-}" ]; then
		[ -f "${ORP_ROOT}/etc/passwd" ] && [ -f "${ORP_ROOT}/etc/group" ] \
			&& grep -q '^svxlink:' "${ORP_ROOT}/etc/passwd" \
			&& grep -q '^svxlink:' "${ORP_ROOT}/etc/group"
		return $?
	fi
	getent passwd svxlink >/dev/null && getent group svxlink >/dev/null
}

function native_service_path() {
	local logical=$1 kind=${2:-dir} path owner
	path=$(native_path "$logical")
	if [ -L "$path" ]; then
		echo "missing: ${logical} is a symbolic link"
		return 1
	fi
	if [ "$kind" = "dir" ] && [ ! -d "$path" ]; then
		echo "missing: ${logical} is not a directory"
		return 1
	fi
	if [ "$kind" = "file" ] && [ ! -f "$path" ]; then
		echo "missing: ${logical} is not a regular file"
		return 1
	fi
	if [ ! -e "$path" ]; then
		echo "missing: ${logical} is absent"
		return 1
	fi
	if native_open_mode "$path"; then
		echo "missing: ${logical} is group or world writable"
		return 1
	fi
	if ! native_harness; then
		owner=$(stat -c '%U:%G' "$path")
		if [ "$owner" != "svxlink:svxlink" ]; then
			echo "missing: ${logical} is ${owner}, expected svxlink:svxlink"
			return 1
		fi
	fi
	echo "ok: ${logical}"
	return 0
}

function native_unit_text() {
	cat <<'EOF'
[Unit]
Description=SvxLink repeater control software
Documentation=man:svxlink(1) man:svxlink.conf(5)
After=network.target

[Service]
Type=simple
User=svxlink
Group=svxlink
UMask=0022
WorkingDirectory=/etc/svxlink
ExecStart=/usr/local/bin/svxlink --logfile=/var/log/svxlink --config=/etc/svxlink/svxlink.conf
Restart=no
TimeoutStopSec=10
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
}

function native_runtime() {
	local rc=0 path expected
	if native_account_ok; then
		echo "ok: user svxlink"
	else
		echo "missing: user and group svxlink"
		rc=1
	fi
	native_service_path /var/lib/svxlink dir || rc=1
	native_service_path /var/spool/svxlink dir || rc=1
	native_service_path /var/log/svxlink file || rc=1
	path=$(native_path /usr/local/lib/systemd/system/svxlink.service)
	if [ -L "$path" ] || [ ! -f "$path" ]; then
		if native_functional_token && native_unit_disabled svxlink.service && native_unit_disabled remotetrx.service && native_unit_disabled svxreflector.service; then
			echo "ok: vendor unit left uninstalled on a functional-test bench"
		else
			echo "missing: /usr/local/lib/systemd/system/svxlink.service is not a regular file"
			rc=1
		fi
	elif ! native_root_owned "$path" || native_open_mode "$path"; then
		echo "missing: vendor svxlink.service is not a root-owned private file"
		rc=1
	else
		expected=$(mktemp)
		native_unit_text > "$expected"
		if cmp -s "$expected" "$path"; then
			echo "ok: /usr/local/lib/systemd/system/svxlink.service"
		else
			echo "missing: vendor svxlink.service does not match the reviewed unit"
			rc=1
		fi
		rm -f "$expected"
	fi
	return "$rc"
}

function native_systemctl() {
	if [ -n "${ORP_SYSTEMCTL:-}" ]; then
		"${ORP_SYSTEMCTL}" "$@"
	else
		systemctl "$@"
	fi
}

# Inlined copy of bench_mode_is_functional_test. This process sources
# nothing. A live run reads only /etc/hostname and
# /etc/openrepeater/operating-mode. The harness may prefix ORP_ROOT on
# those two paths and does not look in the docroot.
# Harness runs must name a fixture root. An empty ORP_ROOT is not the live
# host. Production (harness unset) still reads the real /etc paths.
function harness_note_live_etc() {
	if [ -n "${ORP_LIVE_ETC_LOG:-}" ]; then
		printf '%s\n' "$1" >> "$ORP_LIVE_ETC_LOG"
	fi
}

function path_collapses_to_live_etc() {
	local collapsed
	collapsed=$(printf '%s' "$1" | sed -E 's#/+#/#g')
	case "$collapsed" in
		/etc|/etc/*) return 0 ;;
	esac
	return 1
}

function native_token_path() {
	local rel=$1 resolved
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
		resolved=$(native_path "$rel")
		if path_collapses_to_live_etc "$resolved"; then
			harness_note_live_etc "$resolved"
			printf '%s' "${TMPDIR:-/tmp}/orp-harness-blocked${rel}"
			return 0
		fi
		printf '%s' "$resolved"
		return 0
	fi
	printf '%s' "$rel"
}

function tx_armed_path() {
	if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ] && [ -n "${ORP_TX_ARMED_FILE:-}" ]; then
		printf '%s' "$ORP_TX_ARMED_FILE"
		return 0
	fi
	native_token_path /etc/openrepeater/tx-armed
}

# Root-only flag. Absent unless root creates it over SSH. Same trust checks
# as the functional-test token: not a symlink, mode has no group or world
# write, owner uid 0, and no extended ACL when getfacl is installed.
function tx_armed() {
	local file perm owner
	file=$(tx_armed_path)
	[ -f "$file" ] && [ ! -L "$file" ] || return 1
	perm=$(stat -c %a "$file")
	case "$perm" in
		''|*[!0-7]*) return 1 ;;
	esac
	[ $((8#$perm & 022)) -eq 0 ] || return 1
	owner=$(stat -c %u "$file")
	[ "$owner" = "0" ] || return 1
	if command -v getfacl >/dev/null 2>&1; then
		if getfacl -p -- "$file" 2>/dev/null | grep -Eq '^(user|group):[^:]+:|^mask:'; then
			return 1
		fi
	fi
	# The file body is exactly "armed", with an optional trailing newline.
	local body
	body=$(tr -d '\r' < "$file")
	case "$body" in
		armed|armed$'\n') return 0 ;;
	esac
	return 1
}

function native_functional_token() {
	local file host perm owner token
	file=$(native_token_path /etc/openrepeater/operating-mode)
	host=$(native_token_path /etc/hostname)
	[ -f "$file" ] && [ ! -L "$file" ] || return 1
	[ -f "$host" ] && [ ! -L "$host" ] || return 1
	[ "$(tr -d '[:space:]' < "$host")" = "orp-test" ] || return 1
	perm=$(stat -c %a "$file")
	case "$perm" in
		''|*[!0-7]*) return 1 ;;
	esac
	[ $((8#$perm & 022)) -eq 0 ] || return 1
	owner=$(stat -c %u "$file")
	[ "$owner" = "0" ] || return 1
	if command -v getfacl >/dev/null 2>&1; then
		if getfacl -p -- "$file" 2>/dev/null | grep -Eq '^(user|group):[^:]+:|^mask:'; then
			return 1
		fi
	fi
	token=$(tr -d '[:space:]' < "$file")
	[ "$token" = "functional-test" ]
}

function native_unit_disabled() {
	local enabled active
	set +e
	enabled=$(native_systemctl is-enabled "$1" 2>/dev/null)
	active=$(native_systemctl is-active "$1" 2>/dev/null)
	set -e
	[ "$enabled" = "disabled" ] && [ "$active" = "inactive" ]
}

function native_masks() {
	local rc=0 unit enabled active
	for unit in svxlink.service remotetrx.service svxreflector.service; do
		set +e
		enabled=$(native_systemctl is-enabled "$unit" 2>/dev/null)
		active=$(native_systemctl is-active "$unit" 2>/dev/null)
		set -e
		# Same predicate as bench_assert_masks. A symlink under /etc is
		# not enough, and no file under /etc is required.
		if [ "$enabled" = "masked" ]; then
			echo "ok: ${unit} -> /dev/null"
			continue
		fi
		# A trusted token leaves the unit manageable: enabled, active, or
		# disabled are all accepted. Production without the token is not.
		if native_functional_token; then
			echo "ok: ${unit} manageable in functional-test"
			continue
		fi
		echo "missing: ${unit} is not a /dev/null mask"
		rc=1
	done
	return "$rc"
}

function native_preflight() {
	local rc=0
	native_inputs || rc=1
	native_runtime || rc=1
	native_masks || rc=1
	return "$rc"
}

function native_start_blocked() {
	local path
	path=$(native_path /etc/systemd/system/svxlink.service)
	if [ ! -e "$path" ] && [ ! -L "$path" ]; then
		return 1
	fi
	if [ -L "$path" ] && [ "$(readlink "$path")" = "/dev/null" ]; then
		echo "refused: svxlink.service is masked. Unmask was not performed. Start was not called."
		return 0
	fi
	echo "refused: /etc/systemd/system/svxlink.service is not the administrative mask. Start was not called."
	return 0
}

function config_event_handler() {
	local path
	path=$(native_path /usr/local/share/svxlink/events.tcl)
	config_real_file "$path" || return 1
	printf '%s' /usr/local/share/svxlink/events.tcl
}

function config_module_dir() {
	local path
	path=$(native_path /usr/local/lib/svxlink)
	[ -d "$path" ] && [ ! -L "$path" ] || return 1
	config_real_file "${path}/RepeaterLogic.so" || return 1
	config_real_file "${path}/SimplexLogic.so" || return 1
	printf '%s' /usr/local/lib/svxlink
}

# repeater and simplex are the two logic cores installed under /usr/local/lib/svxlink.
# Anything else, including advanced, is not a 26.05 logic type and is not published.
function config_logic_select() {
	local mode so
	mode=$(config_db_value orp_Mode) || return 1
	case "$mode" in
		repeater)
			logic_name=RepeaterLogic
			logic_type=Repeater
			;;
		simplex)
			logic_name=SimplexLogic
			logic_type=Simplex
			;;
		*)
			echo "refused: orp_Mode is not repeater or simplex. The stored value was not published and the runtime file was not replaced." >&2
			return 1
			;;
	esac
	so=$(native_path "/usr/local/lib/svxlink/${logic_name}.so")
	if ! config_real_file "$so"; then
		echo "refused: ${logic_name}.so is not installed. The runtime file was not replaced." >&2
		return 1
	fi
	return 0
}

function config_callsign() {
	local db value
	db="${ORP_DB_PATH:-${ORP_ROOT:-}/var/lib/openrepeater/db/openrepeater.db}"
	config_real_file "$db" || return 1
	value=$(sqlite3 "$db" "SELECT value FROM settings WHERE keyID='callSign';") || return 1
	case "$value" in
		*[!A-Z0-9]*|"") return 1 ;;
	esac
	local len=${#value}
	[ "$len" -ge 3 ] && [ "$len" -le 12 ] || return 1
	printf '%s' "$value"
}

function config_ancestors_real() {
	local path=$1 acc="" part rest
	case "$path" in
		/*) ;;
		*) return 1 ;;
	esac
	rest=${path#/}
	while [ -n "$rest" ]; do
		part=${rest%%/*}
		if [ "$rest" = "$part" ]; then
			rest=""
		else
			rest=${rest#*/}
		fi
		[ -n "$part" ] || continue
		acc="${acc}/${part}"
		if [ -L "$acc" ]; then
			echo "refused: symbolic link at ${acc}" >&2
			return 1
		fi
		if [ -n "$rest" ] && [ ! -d "$acc" ]; then
			echo "refused: missing directory ${acc}" >&2
			return 1
		fi
	done
	return 0
}

function config_parent_anchored() {
	local parent=$1
	[ -d "$parent" ] && [ ! -L "$parent" ] || return 1
	if find "$parent" -maxdepth 0 -perm /022 | grep -q .; then
		echo "refused: ${parent} is group or world writable" >&2
		return 1
	fi
	return 0
}

function config_db_value() {
	local key=$1 db value
	db="${ORP_DB_PATH:-${ORP_ROOT:-}/var/lib/openrepeater/db/openrepeater.db}"
	config_real_file "$db" || return 1
	value=$(sqlite3 "$db" "SELECT ifnull(value,'') FROM settings WHERE keyID='${key}';") || return 1
	case "$value" in
		*$'\n'*|*$'\r'*) return 1 ;;
	esac
	printf '%s' "$value"
}

function config_ident_mode() {
	case "$1" in
		disabled|morse|voice) return 0 ;;
		custom)
			echo "refused: identification mode custom is not published. The stock 26.05 handler does not play an uploaded clip. The stored mode was not changed." >&2
			return 1
			;;
		*)
			echo "refused: identification mode is not disabled, morse, or voice. The stored mode was not changed." >&2
			return 1
			;;
	esac
}

function config_ident_bool() {
	case "$1" in
		True) printf '1' ;;
		False|"") printf '0' ;;
		*) return 1 ;;
	esac
}

# Read stored identification fields and keep only values the stock 26.05
# handler already understands. Nothing here rewrites the database.
function config_ident_load() {
	local short_mode long_mode short_raw long_raw after_raw append_s append_l
	local wpm pitch short_voice short_cw long_voice long_cw short_covers
	short_mode=$(config_db_value ID_Short_Mode) || return 1
	long_mode=$(config_db_value ID_Long_Mode) || return 1
	short_raw=$(config_db_value ID_Short_IntervalMin) || return 1
	long_raw=$(config_db_value ID_Long_IntervalMin) || return 1
	after_raw=$(config_db_value ID_Short_IdentOnlyAfterTX) || return 1
	append_s=$(config_db_value ID_Short_AppendMorse) || return 1
	append_l=$(config_db_value ID_Long_AppendMorse) || return 1
	wpm=$(config_db_value ID_Morse_WPM) || return 1
	pitch=$(config_db_value ID_Morse_Pitch) || return 1
	config_ident_mode "$short_mode" || return 1
	config_ident_mode "$long_mode" || return 1
	ident_after=$(config_ident_bool "$after_raw") || {
		echo "refused: ID_Short_IdentOnlyAfterTX is not True or False. The stored value was not changed." >&2
		return 1
	}
	case "$append_s" in
		True|False|"") ;;
		*) echo "refused: ID_Short_AppendMorse is not True or False. The stored value was not changed." >&2; return 1 ;;
	esac
	case "$append_l" in
		True|False|"") ;;
		*) echo "refused: ID_Long_AppendMorse is not True or False. The stored value was not changed." >&2; return 1 ;;
	esac
	if [ "$short_mode" = disabled ]; then
		ident_short_interval=0
		short_covers=0
	else
		case "$short_raw" in
			[1-9]|10) ident_short_interval=$short_raw; short_covers=1 ;;
			*)
				echo "refused: short identification interval is not a whole number from 1 through 10. SvxLink 26.05 would still load another SHORT_IDENT_INTERVAL. The stored number was not changed." >&2
				return 1
				;;
		esac
	fi
	if [ "$long_mode" = disabled ]; then
		ident_long_interval=0
	else
		case "$long_raw" in
			[1-9]|[1-9][0-9]|1[0-7][0-9]|180) ;;
			*)
				echo "refused: long identification interval is not a whole number from 1 through 180. The stored number was not changed." >&2
				return 1
				;;
		esac
		if [ "$long_raw" -gt 10 ] && [ "$short_covers" -ne 1 ]; then
			echo "refused: the only enabled identification interval is longer than 10 minutes. SvxLink 26.05 would still load it. The stored number was not changed." >&2
			return 1
		fi
		ident_long_interval=$long_raw
	fi
	short_voice=0
	short_cw=0
	long_voice=0
	long_cw=0
	if [ "$short_mode" = voice ]; then
		short_voice=1
	fi
	if [ "$short_mode" = morse ] || { [ "$short_mode" = voice ] && [ "$append_s" = True ]; }; then
		short_cw=1
	fi
	if [ "$long_mode" = voice ]; then
		long_voice=1
	fi
	if [ "$long_mode" = morse ] || { [ "$long_mode" = voice ] && [ "$append_l" = True ]; }; then
		long_cw=1
	fi
	ident_short_voice=$short_voice
	ident_short_cw=$short_cw
	ident_long_voice=$long_voice
	ident_long_cw=$long_cw
	ident_emit_cw=0
	ident_cw_wpm=""
	ident_cw_pitch=""
	if [ "$short_cw" = 1 ] || [ "$long_cw" = 1 ]; then
		case "$wpm" in
			[1-9]|1[0-9]|20) ;;
			*)
				echo "refused: Morse speed is above 20 words per minute or is not a whole number from 1 through 20. The stored speed was not changed." >&2
				return 1
				;;
		esac
		case "$pitch" in
			400|600|800|1000|1200) ;;
			*)
				echo "refused: Morse pitch is not one of 400, 600, 800, 1000, or 1200. The stored pitch was not changed." >&2
				return 1
				;;
		esac
		ident_emit_cw=1
		ident_cw_wpm=$wpm
		ident_cw_pitch=$pitch
	fi
	return 0
}

# disabled and beep are the only courtesy values published. The file is a
# fixed procedure. It does not contain a database path, a source command,
# or a custom clip. custom and any other value leave the previous file.
function config_courtesy_load() {
	local mode
	mode=$(config_db_value courtesyMode) || return 1
	case "$mode" in
		disabled|beep)
			courtesy_mode=$mode
			;;
		custom)
			echo "refused: custom courtesy is unsupported and was not published. The previous runtime was not changed." >&2
			return 1
			;;
		*)
			echo "refused: courtesyMode is not disabled or beep. The previous runtime was not changed." >&2
			return 1
			;;
	esac
	return 0
}

function config_courtesy_body() {
	case "$courtesy_mode" in
		disabled)
			cat <<'EOF'
namespace eval Logic {
proc send_rgr_sound {} {
  playSilence 100
}
}
EOF
			;;
		beep)
			cat <<'EOF'
namespace eval Logic {
proc send_rgr_sound {} {
  playTone 660 500 200
  playSilence 200
}
}
EOF
			;;
		*)
			return 1
			;;
	esac
}

function config_install_courtesy() {
	local events body
	events=$(native_path /usr/local/share/svxlink/events.d)
	if [ -L "$events" ] || [ ! -d "$events" ]; then
		echo "refused: events.d is not a real directory" >&2
		return 1
	fi
	if ! config_ancestors_real "$events"; then
		return 1
	fi
	if native_open_mode "$events"; then
		echo "refused: events.d is group or world writable" >&2
		return 1
	fi
	body=$(mktemp)
	config_courtesy_body > "$body" || {
		rm -f "$body"
		return 1
	}
	if grep -E -q 'playFile|source[[:space:]]|exec[[:space:]]|\$|\[' "$body"; then
		rm -f "$body"
		echo "refused: courtesy override contains a path or a command" >&2
		return 1
	fi
	python3 - "$events" "$body" <<'PY'
import os, stat, sys
events, src = sys.argv[1], sys.argv[2]
if not events.startswith("/") or "\0" in events or "//" in events:
    sys.stderr.write("refused: unsafe events.d path\n")
    sys.exit(1)
parts = [part for part in events.split("/") if part]
if not parts or any(part in (".", "..") for part in parts):
    sys.stderr.write("refused: unsafe events.d path\n")
    sys.exit(1)
dir_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
fd = os.open("/", dir_flags)
try:
    for part in parts:
        nxt = os.open(part, dir_flags, dir_fd=fd)
        os.close(fd)
        fd = nxt
    try:
        local = os.open("local", dir_flags, dir_fd=fd)
    except FileNotFoundError:
        os.mkdir("local", 0o755, dir_fd=fd)
        local = os.open("local", dir_flags, dir_fd=fd)
    os.close(fd)
    fd = local
    data = open(src, "rb").read()
    leaf = "Logic.tcl"
    try:
        info = os.lstat(leaf, dir_fd=fd)
    except FileNotFoundError:
        info = None
    if info is not None and stat.S_ISLNK(info.st_mode):
        sys.stderr.write("refused: events.d/local/Logic.tcl is a symbolic link\n")
        sys.exit(1)
    flags = os.O_WRONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    try:
        if info is None:
            out = os.open(leaf, flags | os.O_CREAT | os.O_EXCL, 0o644, dir_fd=fd)
        else:
            out = os.open(leaf, flags | os.O_TRUNC, dir_fd=fd)
    except OSError as exc:
        sys.stderr.write("refused: no-follow courtesy write: %s\n" % exc.strerror)
        sys.exit(1)
    try:
        written = os.write(out, data)
        if written != len(data):
            sys.stderr.write("refused: courtesy override was not fully written\n")
            sys.exit(1)
        os.fchmod(out, 0o644)
    finally:
        os.close(out)
except OSError as exc:
    sys.stderr.write("refused: no-follow courtesy path: %s\n" % exc.strerror)
    sys.exit(1)
finally:
    os.close(fd)
PY
	local rc=$?
	rm -f "$body"
	return "$rc"
}

function config_render() {
	local out=$1 callsign events modules cw_lines
	callsign=$(config_callsign) || return 1
	events=$(config_event_handler) || return 1
	modules=$(config_module_dir) || return 1
	config_ident_load || return 1
	config_logic_select || return 1
	cw_block=""
	if [ "$ident_emit_cw" = 1 ]; then
		cw_block="CW_WPM=${ident_cw_wpm}
CW_PITCH=${ident_cw_pitch}"
	fi
	config_courtesy_load || return 1
	cat > "$out" <<EOF
[GLOBAL]
MODULE_PATH=${modules}
LOGIC_CORE_PATH=${modules}
LOGICS=${logic_name}
CFG_DIR=/etc/svxlink/functional-test.d
TIMESTAMP_FORMAT="%c"
CARD_SAMPLE_RATE=16000
[${logic_name}]
TYPE=${logic_type}
RX=Rx1
TX=Tx1
CALLSIGN=${callsign}
SHORT_IDENT_INTERVAL=${ident_short_interval}
LONG_IDENT_INTERVAL=${ident_long_interval}
IDENT_ONLY_AFTER_TX=${ident_after}
EVENT_HANDLER=${events}
SHORT_VOICE_ID_ENABLE=${ident_short_voice}
SHORT_CW_ID_ENABLE=${ident_short_cw}
LONG_VOICE_ID_ENABLE=${ident_long_voice}
LONG_CW_ID_ENABLE=${ident_long_cw}
RGR_SOUND_DELAY=0
${cw_block}
[Rx1]
TYPE=Local
AUDIO_DEV=udp:127.0.0.1:17001
AUDIO_CHANNEL=0
SQL_DET=SIGLEV
SQL_START_DELAY=1
SQL_DELAY=40
SIGLEV_SLOPE=1
SIGLEV_OFFSET=0
SQL_SIGLEV_OPEN_THRESH=30
SQL_SIGLEV_CLOSE_THRESH=10
[Tx1]
TYPE=Local
AUDIO_DEV=udp:127.0.0.1:17002
AUDIO_CHANNEL=0
PTT_TYPE=NONE
EOF
}

function config_dest() {
	native_path /etc/svxlink/svxlink.conf
}

# Read a www-data file into a root temp. head -c enforces the cap. pipefail
# makes a failed cat fail the pipeline. Root does not open the source.
function wwwdata_read_capped() {
	local src=$1 dest=$2 limit=1048576 bytes
	if [ ! -f "$src" ] || [ -L "$src" ]; then
		echo "refused: staged path is not a regular file" >&2
		return 1
	fi
	if ! (set -o pipefail; timeout 5 setpriv --reuid=www-data --regid=www-data --init-groups -- cat -- "$src" | head -c $((limit + 1)) > "$dest"); then
		echo "refused: staged file was not read as www-data" >&2
		return 1
	fi
	bytes=$(wc -c < "$dest" | tr -d ' ')
	if [ "$bytes" -gt "$limit" ]; then
		echo "refused: staged file is larger than ${limit} bytes" >&2
		return 1
	fi
	if [ "$bytes" -eq 0 ]; then
		echo "refused: staged file is empty" >&2
		return 1
	fi
}

# Companion files are read before anything is installed. COMPANION_DIR holds
# the temps and a manifest of "temp dest had_backup".
function prepare_armed_companions() {
	local stage name src dest tmp
	stage=$(module_root_path /var/lib/openrepeater/bench-preview)
	COMPANION_DIR=$(mktemp -d "${TMPDIR:-/tmp}/orp-companions.XXXXXX")
	: > "$COMPANION_DIR/manifest"
	queue_companion() {
		local src=$1 dest=$2 tmp
		tmp=$(mktemp "$COMPANION_DIR/body.XXXXXX")
		if ! wwwdata_read_capped "$src" "$tmp"; then
			return 1
		fi
		printf '%s %s\n' "$tmp" "$dest" >> "$COMPANION_DIR/manifest"
	}
	if [ -e "$stage/gpio.conf" ] || [ -L "$stage/gpio.conf" ]; then
		queue_companion "$stage/gpio.conf" "$(native_path /etc/svxlink/gpio.conf)" || return 1
	fi
	if [ -e "$stage/Logic.tcl" ] || [ -L "$stage/Logic.tcl" ]; then
		queue_companion "$stage/Logic.tcl" "$(native_path /usr/local/share/svxlink/events.d/local/Logic.tcl)" || return 1
	fi
	if [ -d "$stage" ] && [ ! -L "$stage" ]; then
		while IFS= read -r src; do
			[ -n "$src" ] || continue
			name=$(basename "$src")
			case "$name" in
				ORP_RepeaterLogic_Port[0-9].tcl|ORP_RepeaterLogic_Port[0-9][0-9].tcl|ORP_SimplexLogic_Port[0-9].tcl|ORP_SimplexLogic_Port[0-9][0-9].tcl)
					queue_companion "$src" "$(native_path "/usr/local/share/svxlink/events.d/${name}")" || return 1
					;;
				*)
					echo "refused: staged ${name} is not a PortN logic file" >&2
					return 1
					;;
			esac
		done < <(find -P "$stage" -maxdepth 1 -type f -name 'ORP_*Logic_Port*.tcl' | sort)
	fi
}

function rollback_published_conf() {
	local dest=$1 backup=$2 existed=$3
	if [ "$existed" = 1 ] && [ -f "$backup" ]; then
		cp -p "$backup" "$dest"
	else
		rm -f "$dest"
	fi
}

function commit_armed_companions() {
	local tmp dest parent backup_name
	[ -n "${COMPANION_DIR:-}" ] && [ -f "$COMPANION_DIR/manifest" ] || return 0
	: > "$COMPANION_DIR/installed"
	while read -r tmp dest; do
		[ -n "$tmp" ] || continue
		parent=$(dirname "$dest")
		if [ -L "$dest" ]; then
			echo "refused: ${dest} is a symbolic link" >&2
			return 1
		fi
		if [ -d "$dest" ]; then
			echo "refused: ${dest} is a directory" >&2
			return 1
		fi
		if [ ! -d "$parent" ] || [ -L "$parent" ]; then
			echo "refused: ${parent} is not a directory" >&2
			return 1
		fi
		backup_name=$(printf '%s' "$dest" | sha256sum | awk '{print $1}')
		if [ -e "$dest" ]; then
			cp -p "$dest" "$COMPANION_DIR/$backup_name"
			printf 'restore %s %s\n' "$dest" "$COMPANION_DIR/$backup_name" >> "$COMPANION_DIR/installed"
		else
			printf 'remove %s\n' "$dest" >> "$COMPANION_DIR/installed"
		fi
		if ! mv -f "$tmp" "$dest"; then
			echo "refused: ${dest} was not installed" >&2
			return 1
		fi
		chmod 644 "$dest"
	done < "$COMPANION_DIR/manifest"
}

function rollback_armed_companions() {
	local action path bak
	[ -n "${COMPANION_DIR:-}" ] && [ -f "$COMPANION_DIR/installed" ] || return 0
	tac "$COMPANION_DIR/installed" | while read -r action path bak; do
		case "$action" in
			restore) cp -p "$bak" "$path" ;;
			remove) rm -f "$path" ;;
		esac
	done
}

function config_matches_snapshot() {
	local dest expected
	dest=$(config_dest)
	expected=$(mktemp)
	if ! config_render "$expected"; then
		rm -f "$expected"
		return 1
	fi
	cmp -s "$expected" "$dest"
	local rc=$?
	rm -f "$expected"
	return "$rc"
}

function config_publish {
	local dest parent snapshot backup sum_before sum_after
	if ! functional_test_on; then
		echo "refused: config publish requires functional-test"
		return 1
	fi
	# Without tx-armed, the preview file is ignored. With the flag, www-data
	# cats it into the root snapshot below. cp -p is not used.
	if ! config_callsign >/dev/null; then
		echo "refused: stored call sign is not a plain station token. It was not changed and was not published."
		return 1
	fi
	if ! native_inputs; then
		echo "refused: installed SvxLink layout is incomplete. Stored wiring was not changed."
		return 1
	fi
	dest=$(config_dest)
	parent=$(dirname "$dest")
	if ! config_ancestors_real "$parent"; then
		return 1
	fi
	if ! config_parent_anchored "$parent"; then
		return 1
	fi
	if [ -L "$dest" ] || [ -L "${parent}/svxlink.d" ] || [ -L "${parent}/functional-test.d" ]; then
		echo "refused: live svxlink path is a symbolic link"
		return 1
	fi
	if [ -e "${parent}/functional-test.d" ] && [ ! -d "${parent}/functional-test.d" ]; then
		echo "refused: functional-test.d is not a directory"
		return 1
	fi
	if [ ! -d "${parent}/functional-test.d" ]; then
		mkdir -m 755 "${parent}/functional-test.d"
	fi
	if native_open_mode "${parent}/functional-test.d"; then
		echo "refused: functional-test.d is group or world writable"
		return 1
	fi
	if find -P "${parent}/functional-test.d" -mindepth 1 -print | grep -q .; then
		echo "refused: functional-test.d is not empty. Sample svxlink.d files were not copied."
		return 1
	fi
	snapshot=$(mktemp "${parent}/.orp-svxlink.XXXXXX")
	COMPANION_DIR=""
	conf_existed=0
	if native_functional_token && tx_armed; then
		# Advanced mode is not rendered by config_logic_select. The staged
		# set is the publish. Repeater and simplex still record a logic name
		# when the database mode is one of those two.
		mode_now=$(config_db_value orp_Mode || true)
		case "$mode_now" in
			repeater|simplex) config_logic_select || logic_type=staged ;;
			*) logic_type=staged; logic_name=staged ;;
		esac
		staged=$(module_root_path /var/lib/openrepeater/bench-preview/svxlink.conf)
		if ! wwwdata_read_capped "$staged" "$snapshot"; then
			rm -f "$snapshot"
			echo "refused: tx-armed publish needs a regular staged svxlink.conf"
			return 1
		fi
		if ! prepare_armed_companions; then
			rm -rf "$COMPANION_DIR"
			rm -f "$snapshot"
			echo "refused: staged companion was not read"
			return 1
		fi
	elif ! config_logic_select; then
		rm -f "$snapshot"
		return 1
	elif ! config_render "$snapshot"; then
		rm -f "$snapshot"
		echo "refused: disconnected-test config was not rendered"
		return 1
	fi
	sum_before=$(sha256sum "$snapshot" | awk '{print $1}')
	if ! config_courtesy_load; then
		rm -f "$snapshot"
		echo "refused: courtesy mode was not loaded. The runtime config was not replaced."
		return 1
	fi
	courtesy_dest=$(native_path /usr/local/share/svxlink/events.d/local/Logic.tcl)
	courtesy_backup=$(mktemp)
	courtesy_had=0
	if [ -f "$courtesy_dest" ] && [ ! -L "$courtesy_dest" ]; then
		cp -p "$courtesy_dest" "$courtesy_backup"
		courtesy_had=1
	fi
	if ! config_install_courtesy; then
		rm -f "$snapshot" "$courtesy_backup"
		echo "refused: courtesy override was not installed. The runtime config was not replaced."
		return 1
	fi
	if [ -f "$dest" ]; then
		backup=$(native_path "/var/backups/orp-ui/functional-test-$(date -u +%Y%m%dT%H%M%SZ)")
		if ! config_ancestors_real "$(dirname "$backup")"; then
			rm -f "$snapshot"
			rm -rf "${COMPANION_DIR:-}"
			return 1
		fi
		mkdir -p "$backup"
		cp -p "$dest" "$backup/svxlink.conf"
		conf_existed=1
	fi
	if ! mv -f "$snapshot" "$dest"; then
		rm -f "$snapshot"
		rm -rf "${COMPANION_DIR:-}"
		if [ "$courtesy_had" = 1 ]; then
			cp -p "$courtesy_backup" "$courtesy_dest"
		else
			rm -f "$courtesy_dest"
		fi
		rm -f "$courtesy_backup"
		echo "refused: runtime config was not replaced"
		return 1
	fi
	chmod 644 "$dest"
	if ! commit_armed_companions; then
		rollback_armed_companions
		rollback_published_conf "$dest" "${backup:-}/svxlink.conf" "$conf_existed"
		rm -rf "${COMPANION_DIR:-}"
		if [ "$courtesy_had" = 1 ]; then
			cp -p "$courtesy_backup" "$courtesy_dest"
		fi
		rm -f "$courtesy_backup"
		echo "refused: staged companion was not installed. The published set was rolled back."
		return 1
	fi
	rm -rf "${COMPANION_DIR:-}"
	sum_after=$(sha256sum "$dest" | awk '{print $1}')
	rm -f "$courtesy_backup"
	if [ "$sum_before" != "$sum_after" ]; then
		echo "refused: published bytes did not match the rendered snapshot"
		return 1
	fi
	echo "published ${dest}"
	echo "snapshot=${sum_after}"
	ptt_type=$(sed -n 's/^PTT_TYPE=//p' "$dest" | head -n 1)
	ptt_pin=$(sed -n 's/^PTT_PIN=//p' "$dest" | head -n 1)
	awk '
		/^\[/ { sec=$0; next }
		/^PTT_TYPE=/ { t[sec]=substr($0, 10); seen[++n]=sec }
		/^PTT_PIN=/ { p[sec]=substr($0, 9) }
		END {
			for (i = 1; i <= n; i++) {
				s = seen[i]
				if (s ~ /^\[(Tx|TX)/) {
					printf "tx-section=%s PTT_TYPE=%s", s, t[s]
					if (p[s] != "") printf " PTT_PIN=%s", p[s]
					printf "\n"
				}
			}
		}
	' "$dest"
	if [ -n "$ptt_type" ] && [ "$ptt_type" != "NONE" ]; then
		echo "runtime=stored-wiring PTT_TYPE=${ptt_type} PTT_PIN=${ptt_pin}"
		echo "logic=${logic_type}"
		echo "gpio=stored-wiring"
	else
		echo "runtime=simulation/dummy-path PTT_TYPE=NONE loopback-udp"
		echo "logic=${logic_type}"
		echo "gpio=not-applied"
	fi
	echo "courtesy=applied"
	echo "courtesy_mode=${courtesy_mode}"
	echo "courtesy_path=/usr/local/share/svxlink/events.d/local/Logic.tcl"
	echo "courtesy_executed=not-run"
	echo "event=$(config_event_handler)"
	echo "stored wiring was not modified"
	echo "service was not started"
}

function system_reboot {
	if native_functional_token; then
		echo "host-action-accepted system restart"
		if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
			return 0
		fi
		shutdown -r now
		return $?
	fi
	if functional_test_on; then
		echo "refused: host reboot stays blocked in functional-test"
		return 1
	fi
	if bench_refuses "system restart"; then
		return 1
	fi
	shutdown -r now
}

function system_shutdown {
	if native_functional_token; then
		echo "host-action-accepted system stop"
		if [ "${ORP_BENCH_TEST_HARNESS:-}" = 1 ]; then
			return 0
		fi
		shutdown -h now
		return $?
	fi
	if functional_test_on; then
		echo "refused: host shutdown stays blocked in functional-test"
		return 1
	fi
	if bench_refuses "system stop"; then
		return 1
	fi
	shutdown -h now
}

function system_uptime {
	uptime
}

function system_user {
	whoami
}


